{
  "info": {
    "name": "Bank Management - Onboarding Flow",
    "description": "Owner sign-in -> provision a client organization -> client admin sign-in -> branches and employees.\nFill ownerPassword / ownerNewPassword / clientNewPassword / employeeNewPassword in the collection variables before running. Tokens, IDs and temporary passwords are captured automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "ownerUsername", "value": "masteradmin" },
    { "key": "ownerPassword", "value": "" },
    { "key": "ownerNewPassword", "value": "" },
    { "key": "ownerToken", "value": "" },
    { "key": "tenantCode", "value": "sharadbank" },
    { "key": "clientAdminUsername", "value": "" },
    { "key": "clientTempPassword", "value": "" },
    { "key": "clientNewPassword", "value": "" },
    { "key": "clientToken", "value": "" },
    { "key": "bankId", "value": "" },
    { "key": "branchId", "value": "" },
    { "key": "employeeUsername", "value": "" },
    { "key": "employeeTempPassword", "value": "" },
    { "key": "employeeNewPassword", "value": "" },
    { "key": "employeeToken", "value": "" }
  ],
  "item": [
    {
      "name": "1. Platform owner",
      "item": [
        {
          "name": "1.1 Owner login",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "const d = pm.response.json().data;",
            "pm.collectionVariables.set('ownerToken', d.accessToken);",
            "pm.test('mustChangePassword flag present', () => pm.expect(d.user).to.have.property('mustChangePassword'));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"tenantCode\": \"platform\",\n  \"username\": \"{{ownerUsername}}\",\n  \"password\": \"{{ownerPassword}}\"\n}" }
          }
        },
        {
          "name": "1.2 Owner change password (first sign-in)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.collectionVariables.set('ownerToken', pm.response.json().data.accessToken);",
            "pm.collectionVariables.set('ownerPassword', pm.collectionVariables.get('ownerNewPassword'));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{ownerToken}}" }
            ],
            "url": "{{baseUrl}}/api/v1/auth/change-password",
            "body": { "mode": "raw", "raw": "{\n  \"currentPassword\": \"{{ownerPassword}}\",\n  \"newPassword\": \"{{ownerNewPassword}}\"\n}" }
          }
        },
        {
          "name": "1.3 Create client organization (tenant)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('201 Created', () => pm.response.to.have.status(201));",
            "const d = pm.response.json().data;",
            "pm.collectionVariables.set('tenantCode', d.tenant.code);",
            "pm.collectionVariables.set('clientAdminUsername', d.adminUsername);",
            "pm.collectionVariables.set('clientTempPassword', d.temporaryPassword);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{ownerToken}}" }
            ],
            "url": "{{baseUrl}}/api/v1/platform/tenants",
            "body": { "mode": "raw", "raw": "{\n  \"code\": \"{{tenantCode}}\",\n  \"organizationName\": \"Sharad Sahakari Bank\",\n  \"plan\": \"GROWTH\",\n  \"limits\": { \"maxBanks\": 1, \"maxBranches\": 10, \"maxEmployees\": 100, \"maxCustomers\": 5000 },\n  \"features\": { \"geofencing\": true, \"incentives\": true, \"multiBranch\": true, \"auditExport\": false },\n  \"admin\": {\n    \"name\": \"Ravi Patil\",\n    \"username\": \"ravi.patil\",\n    \"email\": \"ravi@sharadbank.in\",\n    \"phone\": \"9876543210\"\n  },\n  \"headquarters\": {\n    \"state\": \"Maharashtra\",\n    \"city\": \"Pune\",\n    \"pincode\": \"411001\",\n    \"street\": \"FC Road\",\n    \"latitude\": 18.5204,\n    \"longitude\": 73.8567\n  }\n}" }
          }
        },
        {
          "name": "1.4 List client organizations",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{ownerToken}}" }],
            "url": "{{baseUrl}}/api/v1/platform/tenants"
          }
        }
      ]
    },
    {
      "name": "2. Client super admin",
      "item": [
        {
          "name": "2.1 Client admin login",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.collectionVariables.set('clientToken', pm.response.json().data.accessToken);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"tenantCode\": \"{{tenantCode}}\",\n  \"username\": \"{{clientAdminUsername}}\",\n  \"password\": \"{{clientTempPassword}}\"\n}" }
          }
        },
        {
          "name": "2.2 Client admin change password",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.collectionVariables.set('clientToken', pm.response.json().data.accessToken);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{clientToken}}" }
            ],
            "url": "{{baseUrl}}/api/v1/auth/change-password",
            "body": { "mode": "raw", "raw": "{\n  \"currentPassword\": \"{{clientTempPassword}}\",\n  \"newPassword\": \"{{clientNewPassword}}\"\n}" }
          }
        },
        {
          "name": "2.3 My profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{clientToken}}" }],
            "url": "{{baseUrl}}/api/v1/auth/me"
          }
        },
        {
          "name": "2.4 List banks (own organization only)",
          "event": [{ "listen": "test", "script": { "exec": [
            "const list = pm.response.json().data;",
            "if (list && list.length) pm.collectionVariables.set('bankId', list[0].id);"
          ] } }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{clientToken}}" }],
            "url": "{{baseUrl}}/api/v1/banks"
          }
        },
        {
          "name": "2.5 List branches",
          "event": [{ "listen": "test", "script": { "exec": [
            "const list = pm.response.json().data;",
            "if (list && list.length) pm.collectionVariables.set('branchId', list[0].id);"
          ] } }],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{clientToken}}" }],
            "url": "{{baseUrl}}/api/v1/branches"
          }
        },
        {
          "name": "2.6 Create branch",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('201 Created', () => pm.response.to.have.status(201));",
            "pm.collectionVariables.set('branchId', pm.response.json().data.id);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{clientToken}}" }
            ],
            "url": "{{baseUrl}}/api/v1/branches",
            "body": { "mode": "raw", "raw": "{\n  \"bankId\": \"{{bankId}}\",\n  \"name\": \"Kothrud Branch\",\n  \"ifsc\": \"SHRD0000102\",\n  \"location\": {\n    \"state\": \"Maharashtra\",\n    \"city\": \"Pune\",\n    \"pincode\": \"411038\",\n    \"street\": \"Karve Road\",\n    \"latitude\": 18.5074,\n    \"longitude\": 73.8077\n  },\n  \"radiusMeters\": 200\n}" }
          }
        },
        {
          "name": "2.7 Create employee (with login)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('201 Created', () => pm.response.to.have.status(201));",
            "const d = pm.response.json().data;",
            "pm.collectionVariables.set('employeeUsername', d.username);",
            "pm.collectionVariables.set('employeeTempPassword', d.temporaryPassword);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{clientToken}}" }
            ],
            "url": "{{baseUrl}}/api/v1/employees",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Sneha Joshi\",\n  \"username\": \"sneha.joshi\",\n  \"email\": \"sneha@sharadbank.in\",\n  \"phone\": \"9823012345\",\n  \"role\": \"EMP\",\n  \"designation\": \"Relationship Officer\",\n  \"branchId\": \"{{branchId}}\",\n  \"address\": \"Kothrud, Pune\"\n}" }
          }
        },
        {
          "name": "2.8 List employees",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{clientToken}}" }],
            "url": "{{baseUrl}}/api/v1/employees?page=0&size=20"
          }
        }
      ]
    },
    {
      "name": "3. Employee",
      "item": [
        {
          "name": "3.1 Employee login",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.collectionVariables.set('employeeToken', pm.response.json().data.accessToken);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/v1/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"tenantCode\": \"{{tenantCode}}\",\n  \"username\": \"{{employeeUsername}}\",\n  \"password\": \"{{employeeTempPassword}}\"\n}" }
          }
        },
        {
          "name": "3.2 Employee change password",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.collectionVariables.set('employeeToken', pm.response.json().data.accessToken);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{employeeToken}}" }
            ],
            "url": "{{baseUrl}}/api/v1/auth/change-password",
            "body": { "mode": "raw", "raw": "{\n  \"currentPassword\": \"{{employeeTempPassword}}\",\n  \"newPassword\": \"{{employeeNewPassword}}\"\n}" }
          }
        },
        {
          "name": "3.3 My employee profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{employeeToken}}" }],
            "url": "{{baseUrl}}/api/v1/employees/me"
          }
        }
      ]
    }
  ]
}
