# Copy to .env and replace every value. Never commit the real .env.

# --- Infrastructure credentials -------------------------------------------
DB_URL=jdbc:postgresql://ep-small-voice-bevh4wru-pooler.c-9.us-east-2.aws.neon.tech/neondb?user=neondb_owner&password=npg_Dhsx2AW6Paoy&sslmode=require&channelBinding=require
DB_NAME=neondb
# PostgreSQL superuser: used only by the container to create schemas and service roles.
DB_ADMIN_USERNAME=neondb_owner
DB_ADMIN_PASSWORD=npg_Dhsx2AW6Paoy
# One login per service; each role owns only its own schema (auth_svc -> auth, ...).
AUTH_DB_PASSWORD=npg_Dhsx2AW6Paoy
ORGANIZATION_DB_PASSWORD=npg_Dhsx2AW6Paoy
ATTENDANCE_DB_PASSWORD=npg_Dhsx2AW6Paoy
INCENTIVE_DB_PASSWORD=npg_Dhsx2AW6Paoy
AUDIT_DB_PASSWORD=npg_Dhsx2AW6Paoy
RABBITMQ_USERNAME=bankmanagement
RABBITMQ_PASSWORD=admin
EUREKA_USERNAME=eureka
EUREKA_PASSWORD=eureka

# --- Tokens ----------------------------------------------------------------
JWT_ISSUER=https://auth.bankmanagement.local
# RS256 private key, PKCS#8, base64 of the PEM on one line:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt.pem
#   base64 -w0 jwt.pem        (PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("jwt.pem")))
JWT_PRIVATE_KEY=
# Local quick start only: generate a throw-away key when JWT_PRIVATE_KEY is empty. Must be false in production.
JWT_ALLOW_EPHEMERAL_KEY=true

# --- Data encryption (salary account numbers), 32 random bytes base64 ------
#   openssl rand -base64 32
DATA_ENCRYPTION_KEY=IcEpdKIPZHAjZo42sxC5T2JA0PVLvSUMtxfHjWMjdCU=

# --- Service-to-service trust ------------------------------------------------
# Random secret (min 32 chars) the gateway attaches to every request; services reject
# any call without it, so they cannot be reached directly.  openssl rand -base64 48
INTERNAL_API_TOKEN=WxI/Haecl5rAbTp6gdZ5+U+7ngmTezsIJoVQHPeB1G/tg0JRy7nP0w1aEGzYl6sN
# true = services accept calls only through the gateway (8080). false = each service can also be
# called directly on its own port (auth 8081, organization 8082, ...). Local development only.
GATEWAY_ONLY=false

# --- Edge ------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Swagger UI at the gateway. Development only - keep false in production.
SWAGGER_ENABLED=true

# --- Local runs only (IDE / mvn spring-boot:run) ------------------------------
# Each service reads this .env at startup. application.yml has no credential defaults,
# so these must be set when running outside Docker.
DB_USERNAME=neondb_owner
DB_PASSWORD=npg_Dhsx2AW6Paoy
